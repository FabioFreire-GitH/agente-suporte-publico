# Variáveis de Ambiente Necessárias para o Agente de Suporte

# Chave de API do Google Gemini (usado como LLM e Embedder)
# Obtenha em: https://aistudio.google.com/
GOOGLE_API_KEY=sua_chave_do_google_aqui

# Chave de API do Firecrawl (usado para ler a documentação das URLs)
# Obtenha em: https://www.firecrawl.dev/
FIRECRAWL_API_KEY=sua_chave_do_firecrawl_aqui
